<div id="confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/75 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
  <div class="w-full max-w-md bg-[#121215] border border-[#27272a] rounded-xl p-6 shadow-2xl shadow-black/60" data-confirm-panel>
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-lg bg-[#3b1111] border border-[#ef4444]/30 flex items-center justify-center text-[#ef4444] shrink-0">
        <span class="material-symbols-outlined text-xl">warning</span>
      </div>
      <div class="flex-1 min-w-0">
        <h3 id="confirm-modal-title" class="text-lg font-headline font-bold text-[#fafafa] tracking-tight">Confirmar ação</h3>
        <p id="confirm-modal-message" class="mt-2 text-sm text-[#a1a1aa] leading-relaxed"></p>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-[#27272a] flex items-center justify-end gap-3">
      <button type="button" id="confirm-modal-cancel" class="px-4 py-2.5 rounded-lg bg-[#18181b] hover:bg-[#27272a] text-[#fafafa] border border-[#27272a] text-sm font-medium transition-colors cursor-pointer">
        Cancelar
      </button>
      <button type="button" id="confirm-modal-accept" class="px-4 py-2.5 rounded-lg bg-[#ef4444] hover:bg-[#dc2626] text-white text-sm font-bold transition-colors cursor-pointer">
        Confirmar
      </button>
    </div>
  </div>
</div>
