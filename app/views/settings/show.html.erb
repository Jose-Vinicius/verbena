<div class="max-w-4xl w-full mx-auto py-8 flex flex-col gap-8"
     data-controller="settings"
     data-settings-default-prompt-value="<%= @default_prompt %>"
     data-settings-all-models-value="<%= @available_models.map { |m| m[:id] }.to_json %>">

  <!-- Header -->
  <header class="flex flex-col gap-2">
    <div class="flex items-center gap-2 text-xs font-semibold text-[#a78bfa] uppercase tracking-wider">
      <span class="material-symbols-outlined text-[18px]">tune</span>
      Preferências do Sistema
    </div>
    <h1 class="text-3xl font-headline font-bold tracking-tight text-[#fafafa]">Configurações de IA</h1>
    <p class="text-sm text-[#a1a1aa] max-w-2xl">
      Configure o modelo default do Google Gemini e ajuste o prompt de geração de questões em tempo real, sem necessidade de novo deploy.
    </p>
  </header>

  <%= form_with model: @user, url: settings_path, method: :patch, class: "flex flex-col gap-8", data: { turbo: true } do |f| %>

    <!-- Card 1: Modelo Gemini e Mitigação de Erros -->
    <section class="bg-[#0c0c0f] border border-[#27272a] rounded-lg p-6 flex flex-col gap-6">
      <div class="flex flex-col gap-1 border-b border-[#27272a] pb-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#a78bfa] text-[22px]">smart_toy</span>
            <h2 class="text-lg font-headline font-bold text-[#fafafa]">Modelo Default do Gemini</h2>
          </div>
          <span class="px-2.5 py-1 rounded text-xs font-medium bg-[#18181b] text-[#34d399] border border-[#34d399]/20 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#34d399] animate-pulse"></span>
            Fallback Ativo
          </span>
        </div>
        <p class="text-xs text-[#a1a1aa]">
          Escolha o modelo principal que será utilizado prioritariamente para processar seus resumos e gerar testes.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <label for="user_gemini_model" class="text-sm font-medium text-[#fafafa]">
          Modelo Principal
        </label>
        <%= f.select :gemini_model,
              grouped_options_for_select(
                @available_models.group_by { |m| m[:family] }.transform_values { |models| models.map { |m| ["#{m[:name]} — #{m[:description]}", m[:id]] } },
                @user.effective_gemini_model
              ),
              {},
              class: "w-full bg-[#121215] border border-[#27272a] rounded-lg p-3 text-sm text-[#fafafa] focus:outline-none focus:border-[#a78bfa] focus:ring-1 focus:ring-[#a78bfa] transition-colors cursor-pointer",
              data: {
                settings_target: "modelSelect",
                action: "change->settings#updateFallbackChain"
              } %>
      </div>

      <!-- Explicação do Fallback -->
      <div class="bg-[#121215] border border-[#27272a] rounded-lg p-4 flex flex-col gap-3">
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-[#34d399] text-[20px] mt-0.5">verified_user</span>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold text-[#fafafa]">Mitigação de Sobrecarga e Erros 5xx</span>
            <p class="text-xs text-[#a1a1aa] leading-relaxed">
              Caso o modelo principal selecionado retorne erro de sobrecarga temporária da API (<strong class="text-[#fafafa]">500, 502, 503, 504</strong>) ou limite de requisições (<strong class="text-[#fafafa]">429</strong>), o sistema não interromperá seu fluxo: ele tentará automaticamente os outros modelos disponíveis como contingência até concluir a criação das perguntas.
            </p>
          </div>
        </div>

        <div class="pt-3 border-t border-[#27272a]">
          <span class="text-xs text-[#71717a] block mb-2 font-medium">Ordem de execução planejada:</span>
          <div data-settings-target="fallbackChain" class="text-xs text-[#a1a1aa]">
            <!-- Renderizado dinamicamente pelo Stimulus -->
          </div>
        </div>
      </div>
    </section>

    <!-- Card 2: Customização do Prompt -->
    <section class="bg-[#0c0c0f] border border-[#27272a] rounded-lg p-6 flex flex-col gap-6">
      <div class="flex flex-col gap-1 border-b border-[#27272a] pb-4">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#a78bfa] text-[22px]">psychology</span>
            <h2 class="text-lg font-headline font-bold text-[#fafafa]">Prompt de Geração de Questões</h2>
          </div>

          <div class="flex items-center gap-2">
            <% if @user.custom_prompt.present? %>
              <span class="px-2.5 py-0.5 rounded text-xs font-medium bg-[#a78bfa]/15 text-[#a78bfa] border border-[#a78bfa]/30">
                Personalizado
              </span>
            <% else %>
              <span class="px-2.5 py-0.5 rounded text-xs font-medium bg-[#18181b] text-[#a1a1aa] border border-[#27272a]">
                Padrão Original
              </span>
            <% end %>

            <button type="button"
                    data-action="click->settings#restoreDefaultPrompt"
                    class="px-3 py-1 text-xs font-medium text-[#a1a1aa] hover:text-[#fafafa] bg-[#121215] hover:bg-[#18181b] border border-[#27272a] rounded-md transition-colors flex items-center gap-1.5 focus:outline-none focus:ring-1 focus:ring-[#a78bfa]">
              <span class="material-symbols-outlined text-[15px]">restart_alt</span>
              Restaurar Padrão
            </button>
          </div>
        </div>
        <p class="text-xs text-[#a1a1aa] mt-1">
          Instruções do sistema enviadas para a IA. Você pode refinar critérios pedagógicos, tipos de perguntas e regras de formatação sem precisar de novo deploy.
        </p>
      </div>

      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between text-xs text-[#a1a1aa]">
          <span>Instruções do Sistema (System Instruction)</span>
          <span data-settings-target="charCount">0 caracteres</span>
        </div>

        <%= f.text_area :custom_prompt,
              value: @current_prompt,
              rows: 18,
              class: "w-full font-mono text-xs leading-relaxed bg-[#121215] border border-[#27272a] rounded-lg p-4 text-[#fafafa] placeholder:text-[#71717a] focus:outline-none focus:border-[#a78bfa] focus:ring-1 focus:ring-[#a78bfa] transition-colors resize-y select-text",
              data: {
                settings_target: "promptInput",
                action: "input->settings#updateCharCount"
              } %>
        
        <p class="text-[11px] text-[#71717a]">
          Dica: Mantenha as especificações de campos JSON (<code class="text-[#a78bfa]">statement</code>, <code class="text-[#a78bfa]">options</code>, <code class="text-[#a78bfa]">correct_index</code>, <code class="text-[#a78bfa]">explanation</code>) para assegurar que as questões sejam salvas corretamente no banco.
        </p>
      </div>
    </section>

    <!-- Barra de Ações -->
    <div class="flex items-center justify-between pt-4 border-t border-[#27272a]">
      <%= link_to root_path, class: "px-4 py-2 text-sm text-[#a1a1aa] hover:text-[#fafafa] transition-colors" do %>
        Voltar ao Início
      <% end %>

      <div class="flex items-center gap-3">
        <%= button_tag type: "submit", class: "bg-[#a78bfa] hover:bg-[#c4b5fd] text-[#0a0012] font-headline font-semibold text-sm rounded-lg px-6 py-2.5 transition-colors flex items-center gap-2 shadow-[0_0_15px_rgba(167,139,250,0.2)] focus:outline-none focus:ring-2 focus:ring-[#a78bfa] focus:ring-offset-2 focus:ring-offset-[#09090b]" do %>
          <span class="material-symbols-outlined text-[18px]">save</span>
          Salvar Configurações
        <% end %>
      </div>
    </div>
  <% end %>
</div>
